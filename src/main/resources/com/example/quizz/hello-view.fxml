<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="461.0" prefWidth="347.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.quizz.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <ImageView fitHeight="150.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
         <viewport>
            <Rectangle2D />
         </viewport>
      </ImageView>
      <Button fx:id="btnNewGame" mnemonicParsing="false" onAction="#onNewGameClick" text="Nouvelle partie" />
      <Button fx:id="btnLoad" mnemonicParsing="false" text="Reprendre" />
      <Button fx:id="btnQuit" mnemonicParsing="false" onAction="#onQuitClick" text="Quitter" />
   </children>
</VBox>
