<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane prefHeight="500.0"
            prefWidth="600.0"
            style="-fx-background-color: #1a1a1a"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.quizz.HelloController">
   <children>
      <ImageView fitHeight="500.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@example/Quizz_font.jpg" />
         </image>
      </ImageView>

      <Label fx:id="dialogueLabel" layoutX="50.0" layoutY="350.0" prefWidth="500.0"
             style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
             text="En cours..." wrapText="true" />

      <Button layoutX="260.0" layoutY="430.0" text="Next" />
   </children>
</AnchorPane>